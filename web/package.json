{
  "name": "circle-lens",
  "version": "0.5.0",
  "description": "Draw a circle twice with the mouse to open a magnifying lens that follows the pointer. Add it to any website with one script tag or one import.",
  "keywords": [
    "magnifier",
    "magnifying-glass",
    "zoom",
    "lens",
    "accessibility",
    "a11y",
    "gesture",
    "low-vision"
  ],
  "homepage": "https://github.com/fauzulkc/circle-lens/tree/main/web#readme",
  "bugs": {
    "url": "https://github.com/fauzulkc/circle-lens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fauzulkc/circle-lens.git",
    "directory": "web"
  },
  "license": "MIT",
  "author": "Fauzul Chowdhury",
  "type": "module",
  "main": "./dist/circle-lens.cjs",
  "module": "./dist/circle-lens.mjs",
  "types": "./index.d.ts",
  "unpkg": "./dist/circle-lens.min.js",
  "jsdelivr": "./dist/circle-lens.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/circle-lens.mjs",
      "require": "./dist/circle-lens.cjs"
    },
    "./script": "./dist/circle-lens.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts",
    "AI_INSTRUCTIONS.md"
  ],
  "sideEffects": [
    "./dist/circle-lens.min.js"
  ]
}
