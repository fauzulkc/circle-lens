{
  "manifest_version": 3,
  "name": "Circle Lens",
  "version": "0.1.0",
  "description": "Draw a circle twice with the mouse to open a magnifying lens that follows the pointer.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Circle Lens: open or close the lens",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "commands": {
    "toggle-lens": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open or close the lens at the pointer"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "{6f1c2a9e-3b47-4d1a-9c5e-2e8b7f0d4a31}",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
